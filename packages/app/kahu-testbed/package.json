{
  "name": "@kahustack/opendaw-testbed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "predev": "node ../../../scripts/stage-kahu-runtime.mjs && node ../../../scripts/build-kahu-worklet.mjs",
    "dev": "vite --clearScreen false",
    "pretypecheck": "node ../../../scripts/stage-kahu-runtime.mjs",
    "prebuild": "node ../../../scripts/stage-kahu-runtime.mjs && node ../../../scripts/build-kahu-worklet.mjs",
    "build": "tsc && vite build",
    "precheck:runtime": "node ../../../scripts/stage-kahu-runtime.mjs",
    "check:runtime": "node ../../../scripts/check-kahu-runtime.mjs",
    "preview": "vite preview --host",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "pretest": "node ../../../scripts/stage-kahu-runtime.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opendaw/lib-jsx": "^0.0.93",
    "@opendaw/studio-enums": "^0.1.4"
  },
  "devDependencies": {
    "@opendaw/eslint-config": "^0.0.28",
    "@opendaw/typescript-config": "^0.0.32",
    "@types/node": "^22.15.18",
    "eslint": "^8.57.0",
    "sass": "^1.88.0",
    "vite": "^7.0.2",
    "vite-plugin-cross-origin-isolation": "^0.1.6",
    "vitest": "^3.1.3"
  }
}
